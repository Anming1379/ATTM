<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题 -->
    <SolidColorBrush x:Key="Brush.Window"           Color="#FF141417" />
    <SolidColorBrush x:Key="Brush.Surface"          Color="#FF1C1C21" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"       Color="#FF232329" />
    <SolidColorBrush x:Key="Brush.Border"           Color="#FF2E2E36" />
    <SolidColorBrush x:Key="Brush.BorderStrong"     Color="#FF3A3A44" />

    <SolidColorBrush x:Key="Brush.Text"             Color="#FFE8E8ED" />
    <SolidColorBrush x:Key="Brush.TextSecondary"    Color="#FF9AA0AE" />
    <SolidColorBrush x:Key="Brush.TextDisabled"     Color="#FF5D6373" />

    <SolidColorBrush x:Key="Brush.Accent"           Color="#FFFF4E6A" />
    <SolidColorBrush x:Key="Brush.AccentHover"      Color="#FFFF6B83" />
    <SolidColorBrush x:Key="Brush.AccentSoft"       Color="#26FF4E6A" />
    <SolidColorBrush x:Key="Brush.AccentSoftStrong" Color="#40FF4E6A" />

    <SolidColorBrush x:Key="Brush.Selection"        Color="#4DFF4E6A" />
    <SolidColorBrush x:Key="Brush.PlayHighlight"    Color="#47FF4E6A" />
    <SolidColorBrush x:Key="Brush.Caret"            Color="#FFFF4E6A" />

    <SolidColorBrush x:Key="Brush.Error"            Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="Brush.ErrorSoft"        Color="#33FF6B6B" />
    <SolidColorBrush x:Key="Brush.Success"          Color="#FF4ECB71" />

    <SolidColorBrush x:Key="Brush.Gutter"           Color="#FF1A1A1F" />
    <SolidColorBrush x:Key="Brush.GutterText"       Color="#FF5D6373" />
    <SolidColorBrush x:Key="Brush.GutterTextActive" Color="#FFB9BFCC" />
    <SolidColorBrush x:Key="Brush.CurrentLine"      Color="#14FFFFFF" />

    <!-- 语法配色 -->
    <SolidColorBrush x:Key="Brush.Syntax.Comment"   Color="#FF6A6A78" />
    <SolidColorBrush x:Key="Brush.Syntax.Directive" Color="#FF7FB4FF" />
    <SolidColorBrush x:Key="Brush.Syntax.Value"     Color="#FFFFB86C" />
    <SolidColorBrush x:Key="Brush.Syntax.Note"      Color="#FFE8E8ED" />
    <SolidColorBrush x:Key="Brush.Syntax.Octave"    Color="#FFC792EA" />
    <SolidColorBrush x:Key="Brush.Syntax.OctaveDown" Color="#FF5FC8D8" />
    <SolidColorBrush x:Key="Brush.Syntax.Sharp"     Color="#FFFF7B72" />
    <SolidColorBrush x:Key="Brush.Syntax.Punctuation" Color="#FF5D6373" />
    <SolidColorBrush x:Key="Brush.Syntax.Rest"      Color="#FF565B6B" />

    <!-- 钢琴键盘 -->
    <SolidColorBrush x:Key="Brush.Piano.White"      Color="#FFDADAE4" />
    <SolidColorBrush x:Key="Brush.Piano.Black"      Color="#FF16161B" />
    <SolidColorBrush x:Key="Brush.Piano.WhiteText"  Color="#FF55556A" />
    <SolidColorBrush x:Key="Brush.Piano.BlackText"  Color="#FF8E8EA0" />

    <Color x:Key="Color.Accent">#FFFF4E6A</Color>
    <Color x:Key="Color.Window">#FF141417</Color>

</ResourceDictionary>
