<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题 -->
    <SolidColorBrush x:Key="Brush.Window"           Color="#FFF7F7F9" />
    <SolidColorBrush x:Key="Brush.Surface"          Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"       Color="#FFF0F0F3" />
    <SolidColorBrush x:Key="Brush.Border"           Color="#FFDCDCE3" />
    <SolidColorBrush x:Key="Brush.BorderStrong"     Color="#FFC3C3CE" />

    <SolidColorBrush x:Key="Brush.Text"             Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="Brush.TextSecondary"    Color="#FF6B7280" />
    <SolidColorBrush x:Key="Brush.TextDisabled"     Color="#FFA8AEB8" />

    <SolidColorBrush x:Key="Brush.Accent"           Color="#FFFF4E6A" />
    <SolidColorBrush x:Key="Brush.AccentHover"      Color="#FFE63F5B" />
    <SolidColorBrush x:Key="Brush.AccentSoft"       Color="#1AFF4E6A" />
    <SolidColorBrush x:Key="Brush.AccentSoftStrong" Color="#33FF4E6A" />

    <SolidColorBrush x:Key="Brush.Selection"        Color="#33FF4E6A" />
    <SolidColorBrush x:Key="Brush.PlayHighlight"    Color="#33FF4E6A" />
    <SolidColorBrush x:Key="Brush.Caret"            Color="#FFFF4E6A" />

    <SolidColorBrush x:Key="Brush.Error"            Color="#FFD93025" />
    <SolidColorBrush x:Key="Brush.ErrorSoft"        Color="#1FD93025" />
    <SolidColorBrush x:Key="Brush.Success"          Color="#FF1E8E3E" />

    <SolidColorBrush x:Key="Brush.Gutter"           Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="Brush.GutterText"       Color="#FF9AA0AE" />
    <SolidColorBrush x:Key="Brush.GutterTextActive" Color="#FF4A5060" />
    <SolidColorBrush x:Key="Brush.CurrentLine"      Color="#0D000000" />

    <!-- 语法配色 -->
    <SolidColorBrush x:Key="Brush.Syntax.Comment"   Color="#FF9198A6" />
    <SolidColorBrush x:Key="Brush.Syntax.Directive" Color="#FF2B6CB0" />
    <SolidColorBrush x:Key="Brush.Syntax.Value"     Color="#FFB45309" />
    <SolidColorBrush x:Key="Brush.Syntax.Note"      Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="Brush.Syntax.Octave"    Color="#FF7C3AED" />
    <SolidColorBrush x:Key="Brush.Syntax.OctaveDown" Color="#FF0E7C86" />
    <SolidColorBrush x:Key="Brush.Syntax.Sharp"     Color="#FFD93025" />
    <SolidColorBrush x:Key="Brush.Syntax.Punctuation" Color="#FF7A8194" />
    <SolidColorBrush x:Key="Brush.Syntax.Rest"      Color="#FF9AA0AE" />

    <!-- 钢琴键盘 -->
    <SolidColorBrush x:Key="Brush.Piano.White"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Piano.Black"      Color="#FF1B1B22" />
    <SolidColorBrush x:Key="Brush.Piano.WhiteText"  Color="#FF7A8194" />
    <SolidColorBrush x:Key="Brush.Piano.BlackText"  Color="#FFB9BFCC" />

    <Color x:Key="Color.Accent">#FFFF4E6A</Color>
    <Color x:Key="Color.Window">#FFF7F7F9</Color>

</ResourceDictionary>
