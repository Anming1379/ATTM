<Window x:Class="ATTM.Views.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件管理器"
        Width="760" Height="540"
        MinWidth="620" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Size.UI}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="插件" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                    <ItemsControl x:Name="PluginList" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Margin="16"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="没有扫描到插件。把插件 dll 放到下面任意一个目录后重启：&#x0a;&#x0a;· 程序目录\plugins\&#x0a;· %APPDATA%\ATTM\plugins\" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HintText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Text="开关改动会在重启后生效；禁用只是不装载，不会删除文件。" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="重新加载插件" Style="{StaticResource TextButton}"
                        Padding="14,6" Margin="0,0,10,0" Click="Reload_Click" />
                <Button Content="打开插件目录" Style="{StaticResource TextButton}"
                        Padding="14,6" Click="OpenFolder_Click" />
                <Button Content="关闭" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" Padding="18,6" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
