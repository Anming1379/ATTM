<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>ATTM</AssemblyName>
    <RootNamespace>ATTM</RootNamespace>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>ATTM - ALambda Text To Midi</Product>
    <AssemblyTitle>ATTM</AssemblyTitle>
    <Company>Anming_cat</Company>
    <Description>用纯文本快速写 MIDI 谱</Description>
    <Copyright>MIT License</Copyright>
    <Version>0.2.1</Version>
    <FileVersion>0.2.1.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试工程有自己的 .cs 文件，不参与主程序编译 -->
    <Compile Remove="tests\**" />
    <Compile Remove="plugins\**" />
    <None Remove="plugins\**" />
    <Page Remove="plugins\**" />
    <Resource Remove="plugins\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <Resource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="assets\**" />
    <Resource Include="assets\fonts\*.ttf" />
    <Resource Include="assets\icon.ico" />
  </ItemGroup>

</Project>
